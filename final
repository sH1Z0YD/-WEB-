DO $$
BEGIN
    IF NOT EXISTS (
        SELECT FROM pg_database
        WHERE datname = 'university_db'
    ) THEN
        EXECUTE 'CREATE DATABASE university_db';
    END IF;
END $$;

CREATE SCHEMA IF NOT EXISTS university;

CREATE TABLE IF NOT EXISTS university.students (
    student_id SERIAL PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    full_name VARCHAR(150)
    GENERATED ALWAYS AS (
        first_name || ' ' || last_name
    ) STORED,
    email VARCHAR(120) NOT NULL UNIQUE,
    gender VARCHAR(10) NOT NULL,
    birth_date DATE,
    enrollment_date DATE NOT NULL DEFAULT CURRENT_DATE,
    gpa NUMERIC(3,2)
);

CREATE TABLE IF NOT EXISTS university.departments (
    department_id SERIAL PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL UNIQUE,
    building VARCHAR(100) NOT NULL,
    total_courses INT DEFAULT 0
);

CREATE TABLE IF NOT EXISTS university.professors (
    professor_id SERIAL PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    full_name VARCHAR(150)
    GENERATED ALWAYS AS (
        first_name || ' ' || last_name
    ) STORED,
    email VARCHAR(120) NOT NULL UNIQUE,
    hire_date DATE NOT NULL
);

CREATE TABLE IF NOT EXISTS university.courses (
    course_id SERIAL PRIMARY KEY,
    department_id INT NOT NULL
    REFERENCES university.departments(department_id)
    ON DELETE CASCADE,
    professor_id INT
    REFERENCES university.professors(professor_id)
    ON DELETE SET NULL,
    course_name VARCHAR(120) NOT NULL UNIQUE,
    credits INT NOT NULL,
    course_fee NUMERIC(10,2) NOT NULL
);

CREATE TABLE IF NOT EXISTS university.classrooms (
    classroom_id SERIAL PRIMARY KEY,
    building VARCHAR(100) NOT NULL,
    room_number VARCHAR(20) NOT NULL UNIQUE,
    capacity INT NOT NULL
);

CREATE TABLE IF NOT EXISTS university.schedules (
    schedule_id SERIAL PRIMARY KEY,
    course_id INT NOT NULL
    REFERENCES university.courses(course_id)
    ON DELETE CASCADE,
    classroom_id INT NOT NULL
    REFERENCES university.classrooms(classroom_id)
    ON DELETE RESTRICT,
    lesson_day VARCHAR(20) NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL
);

CREATE TABLE IF NOT EXISTS university.enrollments (
    enrollment_id SERIAL PRIMARY KEY,
    student_id INT NOT NULL
    REFERENCES university.students(student_id)
    ON DELETE CASCADE,
    course_id INT NOT NULL
    REFERENCES university.courses(course_id)
    ON DELETE CASCADE,
    enrolled_at DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'active'
);

CREATE TABLE IF NOT EXISTS university.student_clubs (
    club_id SERIAL PRIMARY KEY,
    club_name VARCHAR(100) NOT NULL UNIQUE,
    created_at DATE DEFAULT CURRENT_DATE
);

CREATE TABLE IF NOT EXISTS university.student_club_members (
    membership_id SERIAL PRIMARY KEY,
    student_id INT NOT NULL
    REFERENCES university.students(student_id)
    ON DELETE CASCADE,
    club_id INT NOT NULL
    REFERENCES university.student_clubs(club_id)
    ON DELETE CASCADE,
    joined_at DATE DEFAULT CURRENT_DATE
);

ALTER TABLE university.students
ADD COLUMN IF NOT EXISTS phone_number VARCHAR(15);

ALTER TABLE university.students
ALTER COLUMN phone_number TYPE VARCHAR(20);

ALTER TABLE university.schedules
RENAME COLUMN lesson_day TO weekday;

ALTER TABLE university.courses
ALTER COLUMN course_fee SET DEFAULT 0;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'unique_room_number'
    ) THEN
        ALTER TABLE university.classrooms
        ADD CONSTRAINT unique_room_number UNIQUE(room_number);
    END IF;
END $$;

DO $$
BEGIN

    IF EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'check_gender'
    ) THEN
        ALTER TABLE university.students
        DROP CONSTRAINT check_gender;
    END IF;

    IF EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'check_gpa'
    ) THEN
        ALTER TABLE university.students
        DROP CONSTRAINT check_gpa;
    END IF;

    IF EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'check_course_fee'
    ) THEN
        ALTER TABLE university.courses
        DROP CONSTRAINT check_course_fee;
    END IF;

    IF EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'check_enrollment_date'
    ) THEN
        ALTER TABLE university.enrollments
        DROP CONSTRAINT check_enrollment_date;
    END IF;

    IF EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'check_enrollment_status'
    ) THEN
        ALTER TABLE university.enrollments
        DROP CONSTRAINT check_enrollment_status;
    END IF;

END $$;

ALTER TABLE university.students
ADD CONSTRAINT check_gender
CHECK (gender IN ('M', 'F', 'Other'));

ALTER TABLE university.students
ADD CONSTRAINT check_gpa
CHECK (gpa >= 0);

ALTER TABLE university.courses
ADD CONSTRAINT check_course_fee
CHECK (course_fee >= 0);

ALTER TABLE university.enrollments
ADD CONSTRAINT check_enrollment_date
CHECK (enrolled_at > DATE '2026-01-01');

ALTER TABLE university.enrollments
ADD CONSTRAINT check_enrollment_status
CHECK (status IN ('active', 'completed', 'dropped'));

