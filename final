DO $$
BEGIN

    IF EXISTS (
        SELECT FROM pg_roles
        WHERE rolname = 'university_readonly'
    ) THEN
        REASSIGN OWNED BY university_readonly TO CURRENT_USER;
        DROP OWNED BY university_readonly;
        DROP ROLE university_readonly;
    END IF;

    IF EXISTS (
        SELECT FROM pg_roles
        WHERE rolname = 'university_editor'
    ) THEN
        REASSIGN OWNED BY university_editor TO CURRENT_USER;
        DROP OWNED BY university_editor;
        DROP ROLE university_editor;
    END IF;

END $$;

CREATE ROLE university_readonly;

CREATE ROLE university_editor;

GRANT USAGE ON SCHEMA university
TO university_readonly, university_editor;

GRANT SELECT
ON ALL TABLES IN SCHEMA university
TO university_readonly;

GRANT INSERT, UPDATE
ON university.enrollments
TO university_editor;

REVOKE UPDATE
ON university.enrollments
FROM university_editor;
