CREATE TABLE IF NOT EXISTS car_rental.person (
    person_id SERIAL PRIMARY KEY,
    first_name VARCHAR(20) NOT NULL,
    last_name VARCHAR(20) NOT NULL,
    phone_number VARCHAR(25) UNIQUE NOT NULL
);

CREATE TABLE IF NOT EXISTS car_rental.customer (
    customer_id INT PRIMARY KEY REFERENCES car_rental.person(person_id),
    driver_license VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(50) UNIQUE NOT NULL,
    gender VARCHAR(10) NOT NULL CHECK (gender IN ('M','F','Other')),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS car_rental.employee (
    employee_id INT PRIMARY KEY REFERENCES car_rental.person(person_id),
    position VARCHAR(30) NOT NULL,
    salary NUMERIC(10,2) NOT NULL CHECK (salary >= 0)
);

CREATE TABLE IF NOT EXISTS car_rental.branch (
    branch_id SERIAL PRIMARY KEY,
    name VARCHAR(30) NOT NULL UNIQUE,
    city VARCHAR(30) NOT NULL
);

CREATE TABLE IF NOT EXISTS car_rental.category (
    category_id SERIAL PRIMARY KEY,
    name VARCHAR(30) UNIQUE NOT NULL,
    price_per_day NUMERIC(10,2) NOT NULL CHECK (price_per_day >= 0)
);

CREATE TABLE IF NOT EXISTS car_rental.car (
    car_id SERIAL PRIMARY KEY,
    brand VARCHAR(30) NOT NULL,
    model VARCHAR(30) NOT NULL,
    year DATE NOT NULL CHECK (year > DATE '2026-01-01'),
    license_plate VARCHAR(20) UNIQUE NOT NULL,
    status VARCHAR(20) DEFAULT 'available',
    branch_id INT REFERENCES car_rental.branch(branch_id)
);

CREATE TABLE IF NOT EXISTS car_rental.car_category (
    car_id INT REFERENCES car_rental.car(car_id),
    category_id INT REFERENCES car_rental.category(category_id),
    PRIMARY KEY (car_id, category_id)
);

CREATE TABLE IF NOT EXISTS car_rental.rental (
    rental_id SERIAL PRIMARY KEY,
    customer_id INT REFERENCES car_rental.customer(customer_id),
    car_id INT REFERENCES car_rental.car(car_id),
    employee_id INT REFERENCES car_rental.employee(employee_id),
    start_date DATE NOT NULL CHECK (start_date > DATE '2026-01-01'),
    end_date DATE NOT NULL CHECK (end_date > start_date),
    rental_days INT GENERATED ALWAYS AS (end_date - start_date) STORED
);

CREATE TABLE IF NOT EXISTS car_rental.payment (
    payment_id SERIAL PRIMARY KEY,
    rental_id INT REFERENCES car_rental.rental(rental_id),
    amount NUMERIC(10,2) NOT NULL CHECK (amount >= 0),
    payment_date DATE DEFAULT CURRENT_DATE,
    method VARCHAR(20) NOT NULL
);

CREATE TABLE IF NOT EXISTS car_rental.maintenance (
    maintenance_id SERIAL PRIMARY KEY,
    car_id INT REFERENCES car_rental.car(car_id),
    maintenance_date DATE NOT NULL,
    description TEXT NOT NULL,
    cost NUMERIC(10,2) NOT NULL CHECK (cost >= 0)
);

-- Increased employee position length
ALTER TABLE car_rental.employee
ALTER COLUMN position TYPE VARCHAR(40);

-- Add default payment method
ALTER TABLE car_rental.payment
ALTER COLUMN method SET DEFAULT 'card';

-- Remove default after review
ALTER TABLE car_rental.payment
ALTER COLUMN method DROP DEFAULT;

-- Add branch city check
ALTER TABLE car_rental.branch
ADD CONSTRAINT chk_branch_city CHECK (length(city) > 2);

-- Rename status column for clarity
ALTER TABLE car_rental.car
RENAME COLUMN status TO availability_status;

TRUNCATE TABLE
car_rental.maintenance,
car_rental.payment,
car_rental.rental,
car_rental.car_category,
car_rental.car,
car_rental.category,
car_rental.employee,
car_rental.customer,
car_rental.branch,
car_rental.person
RESTART IDENTITY CASCADE;

