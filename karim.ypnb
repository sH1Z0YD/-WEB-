   ],
   "source": [
    "df.groupby('segment').agg(\n",
    "    total_revenue=('revenue', 'sum'),\n",
    "    orders=('order_id', 'count'),\n",
    "    avg_order=('revenue', 'mean'),\n",
    ").round(2).sort_values('total_revenue', ascending=False)"
   ]
  },
